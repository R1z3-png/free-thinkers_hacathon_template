{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 1250,
      "end_ms": 4380,
      "text": "\u0414\u043e\u0431\u0440\u044b\u0439 \u0434\u0435\u043d\u044c! \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043d\u0430\u0447\u043d\u0451\u043c \u0432\u0441\u0442\u0440\u0435\u0447\u0443."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 4550,
      "end_ms": 8170,
      "text": "\u0414\u0430, \u044f \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b \u043a\u0440\u0430\u0442\u043a\u0438\u0439 \u043f\u043b\u0430\u043d \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 8300,
      "end_ms": 12150,
      "text": "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u043e\u0439\u0434\u0451\u043c \u043f\u043e \u0442\u0435\u043a\u0443\u0449\u0435\u043c\u0443 \u0441\u0442\u0430\u0442\u0443\u0441\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0430."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 12300,
      "end_ms": 15800,
      "text": "\u0423 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u0432\u043e\u043f\u0440\u043e\u0441 \u043f\u043e \u0441\u0440\u043e\u043a\u0430\u043c."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 16000,
      "end_ms": 19600,
      "text": "\u041e\u0441\u043d\u043e\u0432\u043d\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u044c \u043a \u043f\u044f\u0442\u043d\u0438\u0446\u0435."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 19800,
      "end_ms": 23100,
      "text": "\u0425\u043e\u0440\u043e\u0448\u043e. \u0410 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u043a\u043e\u0433\u0434\u0430 \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u043c?"
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 23200,
      "end_ms": 26700,
      "text": "\u041f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044e \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043d\u0430 \u043f\u043e\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u0438\u043a."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 26900,
      "end_ms": 30400,
      "text": "\u0422\u0430\u043a \u0443 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0431\u0443\u0434\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u043d\u0430 \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 30600,
      "end_ms": 34100,
      "text": "\u0422\u043e\u0433\u0434\u0430 \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0435\u043c \u044d\u0442\u043e\u0442 \u0432\u0430\u0440\u0438\u0430\u043d\u0442."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 34300,
      "end_ms": 37900,
      "text": "\u042f \u043f\u0440\u0438\u0448\u043b\u044e \u043e\u0431\u043d\u043e\u0432\u043b\u0451\u043d\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u0437\u0430\u0434\u0430\u0447."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 38100,
      "end_ms": 41600,
      "text": "\u042f \u043f\u0440\u043e\u0432\u0435\u0440\u044e, \u0447\u0442\u043e \u0432\u0441\u0435 \u043f\u0443\u043d\u043a\u0442\u044b \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u044b \u0432 \u043e\u0442\u0447\u0451\u0442\u0435."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 41800,
      "end_ms": 45200,
      "text": "\u041e\u0442\u043b\u0438\u0447\u043d\u043e, \u0441\u043f\u0430\u0441\u0438\u0431\u043e."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 45400,
      "end_ms": 48900,
      "text": "\u0415\u0449\u0451 \u043d\u0443\u0436\u043d\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u0442\u044c \u0444\u043e\u0440\u043c\u0430\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 49100,
      "end_ms": 52600,
      "text": "\u0412 JSON \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u043c\u0435\u0442\u043a\u0438 \u0432 \u043c\u0438\u043b\u043b\u0438\u0441\u0435\u043a\u0443\u043d\u0434\u0430\u0445?"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 52800,
      "end_ms": 56200,
      "text": "\u0414\u0430, \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043a \u0443\u043a\u0430\u0437\u0430\u043d\u043e \u0432 \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0435."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 56400,
      "end_ms": 59900,
      "text": "\u0410 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0440\u0435\u043f\u043b\u0438\u043a \u0441\u043e\u0440\u0442\u0438\u0440\u0443\u0435\u043c \u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430\u0447\u0430\u043b\u0430."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 60100,
      "end_ms": 63600,
      "text": "\u0412\u0435\u0440\u043d\u043e. \u041f\u0435\u0440\u0435\u043a\u0440\u044b\u0442\u0438\u0435 \u0440\u0435\u043f\u043b\u0438\u043a \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u043e."
    },
    {
      "speaker_id": "overlap",
      "start_ms": 63800,
      "end_ms": 67400,
      "text": "\u041e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0440\u0435\u0447\u044c \u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 67600,
      "end_ms": 71100,
      "text": "\u0415\u0441\u043b\u0438 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442 \u043d\u0435\u0440\u0430\u0437\u0431\u043e\u0440\u0447\u0438\u0432, \u043d\u0435 \u0431\u0443\u0434\u0435\u043c \u0443\u0433\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u0441\u043b\u043e\u0432\u0430."
    },
    {
      "speaker_id": "unknown",
      "start_ms": 71300,
      "end_ms": 74800,
      "text": "[\u041d\u0435\u0440\u0430\u0437\u0431\u043e\u0440\u0447\u0438\u0432\u043e]"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 75000,
      "end_ms": 78500,
      "text": "\u041f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0440\u0435\u0447\u0438 \u0432\u0435\u0440\u043d\u0451\u0442\u0441\u044f \u043f\u0443\u0441\u0442\u043e\u0439 \u043c\u0430\u0441\u0441\u0438\u0432."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 78700,
      "end_ms": 82100,
      "text": "\u042d\u0442\u043e \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u0431\u0443\u0434\u0435\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0432 JSON."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 82300,
      "end_ms": 85900,
      "text": "\u0422\u043e\u0433\u0434\u0430 \u043f\u043e \u0444\u043e\u0440\u043c\u0430\u0442\u0443 \u0443 \u043d\u0430\u0441 \u0432\u0441\u0451 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u043e."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 86100,
      "end_ms": 89700,
      "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0432\u0441\u0435\u043c. \u041d\u0430 \u044d\u0442\u043e\u043c \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043c."
    }
  ]
}
